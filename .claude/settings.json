{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-guide.sh commit",
            "timeout": 120,
            "statusMessage": "Checking the technical guide is up to date…"
          },
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate-receipt.sh",
            "timeout": 30,
            "statusMessage": "Checking the gate passed on this code…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-guide.sh stop",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
