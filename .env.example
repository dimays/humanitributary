# Copy to .env for local development (`make env` writes one with a random password). Never commit .env.
ENVIRONMENT=dev
# The local Postgres in Docker (docker-compose.yml) listens on host port 5433, so it never meets Postgres.app on 5432.
# POSTGRES_PASSWORD is local-only: docker compose reads it from .env when it first creates the volume.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://tributaries:change-me@localhost:5433/tributaries
# SECRET_KEY=...           # required outside dev
# ALLOWED_HOSTS=...        # comma-separated, outside dev
