# Copy to .env for local development (`make env` writes one with a random password). Never commit .env.
ENVIRONMENT=dev
# The local Postgres in Docker (docker-compose.yml) listens on host port 5433, so it never meets Postgres.app on 5432.
# POSTGRES_PASSWORD is local-only: docker compose reads it from .env when it first creates the volume.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://tributaries:change-me@localhost:5433/tributaries
# SECRET_KEY=...           # required outside dev
# ALLOWED_HOSTS=...        # comma-separated, outside dev
# Ingestion (docs/adr/0013-source-policy.md). INGEST_CONTACT goes in the bot's User-Agent: a generic project address or
# URL (Wikimedia requires a contact), never a person's details.
# INGEST_CONTACT=https://example.org/contact
# Free keys for two lookup adapters; empty = that adapter is disabled. Never commit real keys.
SMITHSONIAN_API_KEY=
EUROPEANA_API_KEY=
# INGEST_START_DOCKER=1    # ops/run-jobs.sh starts Docker Desktop when it isn't running (0 = just skip)
