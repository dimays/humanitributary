# Copy to .env for local development (`make env` writes one with a random password). Never commit .env.
ENVIRONMENT=dev
# The local Postgres in Docker (docker-compose.yml) listens on host port 5433, so it never meets Postgres.app on 5432.
# POSTGRES_PASSWORD is local-only: docker compose reads it from .env when it first creates the volume.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://humanitributary:change-me@localhost:5433/humanitributary
# SECRET_KEY=...           # required outside dev
# ALLOWED_HOSTS=...        # comma-separated, outside dev
# Ingestion (docs/adr/0013-source-policy.md). INGEST_CONTACT goes in the bot's User-Agent: a generic project address or
# URL (Wikimedia requires a contact), never a person's details.
INGEST_CONTACT=https://github.com/dimays/manyages
# Free keys for two lookup adapters; empty = that adapter is disabled. Never commit real keys.
SMITHSONIAN_API_KEY=
EUROPEANA_API_KEY=
# INGEST_START_DOCKER=1    # ops/run-jobs.sh starts Docker Desktop when it isn't running (0 = just skip)
# Object storage (docs/adr/0016-object-storage.md). Locally MinIO from docker-compose.yml (`make env` generates the
# password; `make db` starts it and creates the buckets). In production the same variables point at S3 or Cloudflare
# R2 (S3_REGION=auto and the account endpoint for R2; empty S3_ENDPOINT_URL for AWS). Without them: STORAGE_BACKEND=local
# (var/storage/<bucket>/).
MINIO_ROOT_USER=humanitributary
MINIO_ROOT_PASSWORD=change-me-too
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=humanitributary
S3_SECRET_ACCESS_KEY=change-me-too
S3_REGION=us-east-1
S3_BUCKET_RAW=humanitributary-raw
S3_BUCKET_RELEASES=humanitributary-releases
# STORAGE_BACKEND=local    # force the local directory backend
# MINIO_PORT=9000 MINIO_CONSOLE_PORT=9001   # host ports (127.0.0.1 only)
# The worker and alerts (docs/adr/0019-processes-and-release-gates.md)
# WORKER_TICK_SECONDS=60
# ALERT_AFTER_FAILURES=3
# ALERT_EMAILS=            # comma-separated; with EMAIL_HOST, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD outside dev
# The agent API (docs/adr/0017-agent-api.md): tokens come from `manage.py agent_token create`, never from here.
# AGENT_API_RATE_PER_MINUTE=120
